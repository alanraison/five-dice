    "luxon": "^3.7.2",
    "pino": "^10.1.0",
    "random-word-slugs": "^0.1.7",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@aws-sdk/client-sqs": "^3.972.0",
    "@testcontainers/localstack": "^11.11.0",
    "@types/aws-lambda": "^8.10.159",
    "@types/luxon": "^2.0.7",
    "@vitest/ui": "^4.0.16",
    "aws-cdk": "^2.1100.1",
    "aws-cdk-lib": "^2.233.0",
    "aws-sdk-client-mock": "^4.1.0",
    "aws-sdk-client-mock-vitest": "^7.0.1",
    "concurrently": "^9.2.1",
    "constructs": "^10.4.4",
